<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tela"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_reserva"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/orientacao"
            android:textColor="@color/texto"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:labelFor="@id/quantidade"
            android:text="@string/rotulo_quantidade"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/quantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exemplo_quantidade"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="numberSigned"
            android:maxLines="1"
            android:minHeight="56dp"
            android:padding="12dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="20sp" />

        <Button
            android:id="@+id/validar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primaria"
            android:minHeight="56dp"
            android:padding="12dp"
            android:text="@string/validar_solicitacao"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/mensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:background="@color/fundo_mensagem"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:minHeight="56dp"
            android:padding="16dp"
            android:textColor="@color/texto"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
